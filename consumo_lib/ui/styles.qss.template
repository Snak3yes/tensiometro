/**
 * Qt Style Sheet Global - Tensiometro
 *
 * Segue Material Design 3 principles
 * Usa design tokens definidos em design_tokens.py
 *
 * Última atualização: 2026-03-27
 * Versão: 3.0.0 - Paleta Neutra Industrial: Tons de Cinza
 */

/* =============================================================================
   RESET & BASE
   ============================================================================= */

* {
    outline: none;
}

QWidget {
    background-color: {{BACKGROUND}};
    color: {{TEXT_PRIMARY}};
    font-family: Arial;
    font-size: 12px;
}

/* =============================================================================
   BUTTONS
   ============================================================================= */

QPushButton {
    background-color: {{PRIMARY}};
    color: white;
    border: none;
    border-radius: 3px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: bold;
    min-height: 26px;
}

QPushButton:hover {
    background-color: {{PRIMARY_DARK}};
}

QPushButton:pressed {
    background-color: {{PRIMARY_LIGHT}};
}

QPushButton:disabled {
    background-color: {{BORDER}};
    color: {{TEXT_DISABLED}};
}

/* Button Variants (via property) - v3.0 Paleta Neutra */

/* Primary Green (ações de confirmação/início) - Agora cinza escuro */
QPushButton[variant="primary-green"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #546E7A, stop:1 #37474F);  /* Blue Grey 600-800 */
    border: 1px solid #37474F;
    color: white;
    border-radius: 4px;
    font-weight: 500;
}

QPushButton[variant="primary-green"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #607D8B, stop:1 #455A64);  /* Blue Grey 500-700 */
}

/* Primary Blue (ações padrão/genéricas) - Cinza médio */
QPushButton[variant="primary-blue"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #607D8B, stop:1 #455A64);  /* Blue Grey 500-700 */
    border: 1px solid #455A64;
    color: white;
    border-radius: 4px;
    font-weight: 500;
}

QPushButton[variant="primary-blue"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #78909C, stop:1 #607D8B);  /* Blue Grey 400-500 */
}

/* Primary Orange (ações de parada/atenção) - Cinza mais escuro */
QPushButton[variant="primary-orange"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #455A64, stop:1 #37474F);  /* Blue Grey 700-800 */
    border: 1px solid #37474F;
    color: white;
    border-radius: 4px;
    font-weight: 500;
}

QPushButton[variant="primary-orange"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #546E7A, stop:1 #455A64);  /* Blue Grey 600-700 */
}

/* Secondary (outline - ações alternativas/cancelamento) */
QPushButton[variant="secondary"] {
    background-color: transparent;
    border: 1px solid #607D8B;  /* Blue Grey 500 */
    color: #455A64;
    border-radius: 4px;
    font-weight: 500;
}

QPushButton[variant="secondary"]:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #78909C, stop:1 #607D8B);  /* Blue Grey 400-500 */
    color: white;
}

QPushButton[variant="secondary"]:disabled {
    background-color: transparent;
    border: 2px solid {{BORDER}};
    color: {{TEXT_DISABLED}};
}

/* Emergency (emergências físicas - uso raro 1%) - Cinza muito escuro */
QPushButton[variant="emergency"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #37474F, stop:1 #263238);  /* Blue Grey 800-900 */
    border: 2px solid #263238;
    color: white;
    border-radius: 16px;
    padding: 8px 24px;
    font-weight: 700;
    font-size: 13px;
}

QPushButton[variant="emergency"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #455A64, stop:1 #37474F);  /* Blue Grey 700-800 */
}

QPushButton[variant="emergency"]:disabled {
    background-color: {{BORDER}};
    border: 3px solid {{BORDER_DARK}};
    color: {{TEXT_DISABLED}};
}

/* Danger (DEPRECATED - use emergency instead) - Cinza escuro */
QPushButton[variant="danger"] {
    background-color: #607D8B;  /* Blue Grey 500 */
}

QPushButton[variant="danger"]:hover {
    background-color: #546E7A;  /* Blue Grey 600 */
}

QPushButton[variant="danger"]:pressed {
    background-color: #455A64;  /* Blue Grey 700 */
}

/* Outline (borda cinza - legado, use secondary no futuro) */
QPushButton[variant="outline"] {
    background-color: transparent;
    border: 2px solid #607D8B;
    color: #455A64;
}

QPushButton[variant="outline"]:hover {
    background-color: #78909C;
    color: white;
}

/* =============================================================================
   TEXT & LABELS
   ============================================================================= */

QLabel {
    color: {{TEXT_PRIMARY}};
    background-color: transparent;
}

QLabel[heading="true"] {
    font-size: 16px;
    font-weight: bold;
    color: {{TEXT_PRIMARY}};
}

QLabel[subheading="true"] {
    font-size: 14px;
    font-weight: bold;
    color: {{TEXT_SECONDARY}};
}

QLabel[caption="true"] {
    font-size: 11px;
    color: {{TEXT_DISABLED}};
}

/* =============================================================================
   INPUTS
   ============================================================================= */

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: {{BACKGROUND}};
    border: 1px solid {{BORDER}};
    border-radius: 3px;
    padding: 4px 8px;
    color: {{TEXT_PRIMARY}};
    min-height: 26px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: {{SECONDARY}};
}

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: {{SURFACE_VARIANT}};
    color: {{TEXT_DISABLED}};
}

QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover {
    border-color: {{BORDER_DARK}};
}

/* =============================================================================
   COMBO BOX
   ============================================================================= */

QComboBox {
    background-color: {{BACKGROUND}};
    border: 1px solid {{BORDER}};
    border-radius: 3px;
    padding: 4px 8px;
    min-height: 26px;
}

QComboBox:hover {
    border-color: {{BORDER_DARK}};
}

QComboBox::drop-down {
    border: none;
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: {{BACKGROUND}};
    border: 1px solid {{BORDER}};
    selection-background-color: {{SECONDARY}};
    selection-color: {{TEXT_PRIMARY}};
    padding: 2px;
}

/* =============================================================================
   SPIN BOX
   ============================================================================= */

QSpinBox, QDoubleSpinBox {
    background-color: {{BACKGROUND}};
    border: 1px solid {{BORDER}};
    border-radius: 3px;
    padding: 4px 8px;
    min-height: 26px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: {{SECONDARY}};
}

QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: {{SURFACE_VARIANT}};
    color: {{TEXT_DISABLED}};
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    border-left: 2px solid {{BORDER}};
    background-color: {{SURFACE_VARIANT}};
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover {
    background-color: {{BORDER}};
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
    border-left: 2px solid {{BORDER}};
    border-top: 1px solid {{BORDER}};
    background-color: {{SURFACE_VARIANT}};
}

QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: {{BORDER}};
}

/* =============================================================================
   CHECKBOX & RADIO
   ============================================================================= */

QCheckBox, QRadioButton {
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    border: 2px solid {{TEXT_SECONDARY}};
    background-color: {{BACKGROUND}};
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: {{PRIMARY}};
    border-color: {{PRIMARY}};
    image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjAiIGhlaWdodD0iMjAiIHZpZXdCb3g9IjAgMCAyMCAyMCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cGF0aCBkPSJNNiAxMkwxNiA0IiBzdHJva2U9IndoaXRlIiBzdHJva2Utd2lkdGg9IjIiIGZpbGw9Im5vbmUiLz48L3N2Zz4=);
}

QCheckBox::indicator:checked:hover, QRadioButton::indicator:checked:hover {
    background-color: {{PRIMARY_DARK}};
}

QCheckBox::indicator:unchecked:hover, QRadioButton::indicator:unchecked:hover {
    border-color: {{PRIMARY}};
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background-color: {{SURFACE_VARIANT}};
    border-color: {{BORDER}};
}

/* =============================================================================
   GROUP BOX
   ============================================================================= */

QGroupBox {
    border: 2px solid {{BORDER}};
    border-radius: 8px;
    margin-top: 16px;
    padding: 16px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    padding: 0 8px;
    background-color: {{BACKGROUND}};
}

/* =============================================================================
   SCROLL BAR
   ============================================================================= */

QScrollBar:vertical {
    background-color: {{SURFACE_VARIANT}};
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: {{BORDER_DARK}};
    border-radius: 6px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: {{TEXT_DISABLED}};
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    height: 0px;
}

QScrollBar:horizontal {
    background-color: {{SURFACE_VARIANT}};
    height: 12px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: {{BORDER_DARK}};
    border-radius: 6px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: {{TEXT_DISABLED}};
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
    width: 0px;
}

/* =============================================================================
   PROGRESS BAR
   ============================================================================= */

QProgressBar {
    background-color: {{BORDER}};
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: {{PRIMARY}};
    border-radius: 4px;
}

QProgressBar::chunk:disabled {
    background-color: {{BORDER_DARK}};
}

/* =============================================================================
   TAB WIDGET
   ============================================================================= */

QTabWidget::pane {
    border: 1px solid {{BORDER}};
    border-radius: 4px;
    background-color: {{BACKGROUND}};
}

QTabBar::tab {
    background-color: {{SURFACE_VARIANT}};
    border: 1px solid {{BORDER}};
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 6px 16px;
    margin-right: 2px;
    font-weight: bold;
}

QTabBar::tab:selected {
    background-color: {{BACKGROUND}};
    border-bottom: 1px solid {{BACKGROUND}};
}

QTabBar::tab:hover:!selected {
    background-color: {{SURFACE}};
}

QTabBar::tab:disabled {
    color: {{TEXT_DISABLED}};
}

/* =============================================================================
   TABLE
   ============================================================================= */

QTableView, QTableWidget {
    background-color: {{BACKGROUND}};
    border: 2px solid {{BORDER}};
    border-radius: 8px;
    gridline-color: {{BORDER}};
}

QTableView::item, QTableWidget::item {
    padding: 8px;
    border: none;
}

QTableView::item:selected, QTableWidget::item:selected {
    background-color: {{SECONDARY}};
    color: {{TEXT_PRIMARY}};
}

QTableView::item:hover, QTableWidget::item:hover {
    background-color: {{SURFACE_VARIANT}};
}

QHeaderView::section {
    background-color: {{SURFACE_VARIANT}};
    color: {{TEXT_PRIMARY}};
    padding: 8px;
    border: none;
    border-right: 2px solid {{BORDER}};
    border-bottom: 2px solid {{BORDER}};
    font-weight: bold;
}

QHeaderView::section:hover {
    background-color: {{SURFACE}};
}

/* =============================================================================
   STATUS BADGE (Custom Widget)
   ============================================================================= */

StatusBadge {
    padding: 4px 12px;
    border-radius: 4px;
    font-weight: bold;
    font-size: 11px;
}

/* =============================================================================
   DIALOG
   ============================================================================= */

QDialog {
    background-color: {{BACKGROUND}};
}

/* =============================================================================
   MENU BAR & STATUS BAR (Compacto - 25px / 30px)
   ============================================================================= */

QMenuBar {
    background-color: {{SURFACE_VARIANT}};
    border-bottom: 1px solid {{BORDER}};
    padding: 2px 8px;
    spacing: 4px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 8px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: {{SURFACE}};
}

QStatusBar {
    background-color: {{SURFACE_VARIANT}};
    border-top: 1px solid {{BORDER}};
    padding: 4px 8px;
    spacing: 8px;
}

/* =============================================================================
   MENU
   ============================================================================= */

QMenu {
    background-color: {{BACKGROUND}};
    border: 1px solid {{BORDER}};
    border-radius: 4px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: {{SURFACE_VARIANT}};
}

QMenu::separator {
    height: 1px;
    background-color: {{BORDER}};
    margin: 4px 0;
}

QMenu::indicator {
    width: 16px;
    height: 16px;
    left: 8px;
}

/* =============================================================================
   SLIDER
   ============================================================================= */

QSlider::groove:horizontal {
    height: 4px;
    background: {{BORDER}};
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: {{PRIMARY}};
    width: 20px;
    height: 20px;
    margin: -8px 0;
    border-radius: 10px;
}

QSlider::handle:horizontal:hover {
    background: {{PRIMARY_DARK}};
}

QSlider::groove:vertical {
    width: 4px;
    background: {{BORDER}};
    border-radius: 2px;
}

QSlider::handle:vertical {
    background: {{PRIMARY}};
    width: 20px;
    height: 20px;
    margin: 0 -8px;
    border-radius: 10px;
}

QSlider::handle:vertical:hover {
    background: {{PRIMARY_DARK}};
}

/* =============================================================================
   TOOL TIP
   ============================================================================= */

QToolTip {
    background-color: {{BACKGROUND}};
    color: {{BACKGROUND}};
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

/* =============================================================================
   SCROLL AREA
   ============================================================================= */

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* =============================================================================
   FRAME
   ============================================================================= */

QFrame {
    background-color: transparent;
}

QFrame[frameShape="4"], QFrame[frameShape="5"] {
    /* HLine = 4, VLine = 5 */
    color: {{BORDER}};
}
