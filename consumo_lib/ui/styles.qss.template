/**
 * Qt Style Sheet Global - Tensiometro
 *
 * Segue Material Design 3 principles
 * Usa design tokens definidos em design_tokens.py
 *
 * Última atualização: 2026-01-19
 * Versão: 1.0.0
 */

/* =============================================================================
   RESET & BASE
   ============================================================================= */

* {
    outline: none;
}

QWidget {
    background-color: {{BACKGROUND}};
    color: {{TEXT_PRIMARY}};
    font-family: Arial;
    font-size: 12px;
}

/* =============================================================================
   BUTTONS
   ============================================================================= */

QPushButton {
    background-color: {{PRIMARY}};
    color: white;
    border: none;
    border-radius: 4px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: bold;
    min-height: 40px;
}

QPushButton:hover {
    background-color: {{PRIMARY_DARK}};
}

QPushButton:pressed {
    background-color: {{PRIMARY_LIGHT}};
}

QPushButton:disabled {
    background-color: {{BORDER}};
    color: {{TEXT_DISABLED}};
}

/* Button Variants (via property) */
QPushButton[variant="secondary"] {
    background-color: {{SECONDARY}};
}

QPushButton[variant="secondary"]:hover {
    background-color: {{SECONDARY_DARK}};
}

QPushButton[variant="secondary"]:pressed {
    background-color: {{ON_SECONDARY}};
}

QPushButton[variant="danger"] {
    background-color: {{ERROR}};
}

QPushButton[variant="danger"]:hover {
    background-color: {{ERROR_DARK}};
}

QPushButton[variant="danger"]:pressed {
    background-color: {{ERROR_DARK}};
}

QPushButton[variant="outline"] {
    background-color: transparent;
    border: 2px solid {{PRIMARY}};
    color: {{PRIMARY}};
}

QPushButton[variant="outline"]:hover {
    background-color: {{PRIMARY}};
}

/* =============================================================================
   TEXT & LABELS
   ============================================================================= */

QLabel {
    color: {{TEXT_PRIMARY}};
    background-color: transparent;
}

QLabel[heading="true"] {
    font-size: 16px;
    font-weight: bold;
    color: {{TEXT_PRIMARY}};
}

QLabel[subheading="true"] {
    font-size: 14px;
    font-weight: bold;
    color: {{TEXT_SECONDARY}};
}

QLabel[caption="true"] {
    font-size: 11px;
    color: {{TEXT_DISABLED}};
}

/* =============================================================================
   INPUTS
   ============================================================================= */

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: {{BACKGROUND}};
    border: 2px solid {{BORDER}};
    border-radius: 4px;
    padding: 8px;
    color: {{TEXT_PRIMARY}};
    min-height: 40px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: {{SECONDARY}};
}

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: {{SURFACE_VARIANT}};
    color: {{TEXT_DISABLED}};
}

QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover {
    border-color: {{BORDER_DARK}};
}

/* =============================================================================
   COMBO BOX
   ============================================================================= */

QComboBox {
    background-color: {{BACKGROUND}};
    border: 2px solid {{BORDER}};
    border-radius: 4px;
    padding: 8px;
    min-height: 40px;
}

QComboBox:hover {
    border-color: {{BORDER_DARK}};
}

QComboBox::drop-down {
    border: none;
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: {{BACKGROUND}};
    border: 2px solid {{BORDER}};
    selection-background-color: {{SECONDARY}};
    selection-color: {{TEXT_PRIMARY}};
    padding: 4px;
}

/* =============================================================================
   SPIN BOX
   ============================================================================= */

QSpinBox, QDoubleSpinBox {
    background-color: {{BACKGROUND}};
    border: 2px solid {{BORDER}};
    border-radius: 4px;
    padding: 8px;
    min-height: 40px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: {{SECONDARY}};
}

QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: {{SURFACE_VARIANT}};
    color: {{TEXT_DISABLED}};
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    border-left: 2px solid {{BORDER}};
    background-color: {{SURFACE_VARIANT}};
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover {
    background-color: {{BORDER}};
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
    border-left: 2px solid {{BORDER}};
    border-top: 1px solid {{BORDER}};
    background-color: {{SURFACE_VARIANT}};
}

QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: {{BORDER}};
}

/* =============================================================================
   CHECKBOX & RADIO
   ============================================================================= */

QCheckBox, QRadioButton {
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    border: 2px solid {{TEXT_SECONDARY}};
    background-color: {{BACKGROUND}};
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: {{PRIMARY}};
    border-color: {{PRIMARY}};
    image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjAiIGhlaWdodD0iMjAiIHZpZXdCb3g9IjAgMCAyMCAyMCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cGF0aCBkPSJNNiAxMkwxNiA0IiBzdHJva2U9IndoaXRlIiBzdHJva2Utd2lkdGg9IjIiIGZpbGw9Im5vbmUiLz48L3N2Zz4=);
}

QCheckBox::indicator:checked:hover, QRadioButton::indicator:checked:hover {
    background-color: {{PRIMARY_DARK}};
}

QCheckBox::indicator:unchecked:hover, QRadioButton::indicator:unchecked:hover {
    border-color: {{PRIMARY}};
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background-color: {{SURFACE_VARIANT}};
    border-color: {{BORDER}};
}

/* =============================================================================
   GROUP BOX
   ============================================================================= */

QGroupBox {
    border: 2px solid {{BORDER}};
    border-radius: 8px;
    margin-top: 16px;
    padding: 16px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    padding: 0 8px;
    background-color: {{BACKGROUND}};
}

/* =============================================================================
   SCROLL BAR
   ============================================================================= */

QScrollBar:vertical {
    background-color: {{SURFACE_VARIANT}};
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: {{BORDER_DARK}};
    border-radius: 6px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: {{TEXT_DISABLED}};
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    height: 0px;
}

QScrollBar:horizontal {
    background-color: {{SURFACE_VARIANT}};
    height: 12px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: {{BORDER_DARK}};
    border-radius: 6px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: {{TEXT_DISABLED}};
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
    width: 0px;
}

/* =============================================================================
   PROGRESS BAR
   ============================================================================= */

QProgressBar {
    background-color: {{BORDER}};
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: {{PRIMARY}};
    border-radius: 4px;
}

QProgressBar::chunk:disabled {
    background-color: {{BORDER_DARK}};
}

/* =============================================================================
   TAB WIDGET
   ============================================================================= */

QTabWidget::pane {
    border: 2px solid {{BORDER}};
    border-radius: 8px;
    background-color: {{BACKGROUND}};
}

QTabBar::tab {
    background-color: {{SURFACE_VARIANT}};
    border: 2px solid {{BORDER}};
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 12px 24px;
    margin-right: 4px;
    font-weight: bold;
}

QTabBar::tab:selected {
    background-color: {{BACKGROUND}};
    border-bottom: 2px solid {{BACKGROUND}};
}

QTabBar::tab:hover:!selected {
    background-color: {{SURFACE}};
}

QTabBar::tab:disabled {
    color: {{TEXT_DISABLED}};
}

/* =============================================================================
   TABLE
   ============================================================================= */

QTableView, QTableWidget {
    background-color: {{BACKGROUND}};
    border: 2px solid {{BORDER}};
    border-radius: 8px;
    gridline-color: {{BORDER}};
}

QTableView::item, QTableWidget::item {
    padding: 8px;
    border: none;
}

QTableView::item:selected, QTableWidget::item:selected {
    background-color: {{SECONDARY}};
    color: {{TEXT_PRIMARY}};
}

QTableView::item:hover, QTableWidget::item:hover {
    background-color: {{SURFACE_VARIANT}};
}

QHeaderView::section {
    background-color: {{SURFACE_VARIANT}};
    color: {{TEXT_PRIMARY}};
    padding: 8px;
    border: none;
    border-right: 2px solid {{BORDER}};
    border-bottom: 2px solid {{BORDER}};
    font-weight: bold;
}

QHeaderView::section:hover {
    background-color: {{SURFACE}};
}

/* =============================================================================
   STATUS BADGE (Custom Widget)
   ============================================================================= */

StatusBadge {
    padding: 4px 12px;
    border-radius: 4px;
    font-weight: bold;
    font-size: 11px;
}

/* =============================================================================
   DIALOG
   ============================================================================= */

QDialog {
    background-color: {{BACKGROUND}};
}

/* =============================================================================
   MENU
   ============================================================================= */

QMenu {
    background-color: {{BACKGROUND}};
    border: 2px solid {{BORDER}};
    border-radius: 8px;
    padding: 8px;
}

QMenu::item {
    padding: 8px 16px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: {{SURFACE_VARIANT}};
}

QMenu::separator {
    height: 2px;
    background-color: {{BORDER}};
    margin: 8px 0;
}

QMenu::indicator {
    width: 16px;
    height: 16px;
    left: 8px;
}

/* =============================================================================
   SLIDER
   ============================================================================= */

QSlider::groove:horizontal {
    height: 4px;
    background: {{BORDER}};
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: {{PRIMARY}};
    width: 20px;
    height: 20px;
    margin: -8px 0;
    border-radius: 10px;
}

QSlider::handle:horizontal:hover {
    background: {{PRIMARY_DARK}};
}

QSlider::groove:vertical {
    width: 4px;
    background: {{BORDER}};
    border-radius: 2px;
}

QSlider::handle:vertical {
    background: {{PRIMARY}};
    width: 20px;
    height: 20px;
    margin: 0 -8px;
    border-radius: 10px;
}

QSlider::handle:vertical:hover {
    background: {{PRIMARY_DARK}};
}

/* =============================================================================
   TOOL TIP
   ============================================================================= */

QToolTip {
    background-color: {{BACKGROUND}};
    color: {{BACKGROUND}};
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

/* =============================================================================
   SCROLL AREA
   ============================================================================= */

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* =============================================================================
   FRAME
   ============================================================================= */

QFrame {
    background-color: transparent;
}

QFrame[frameShape="4"], QFrame[frameShape="5"] {
    /* HLine = 4, VLine = 5 */
    color: {{BORDER}};
}
