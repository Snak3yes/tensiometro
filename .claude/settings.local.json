{
  "permissions": {
    "allow": [
      "Bash(wc:*)",
      "Bash(python:*)",
      "Bash(for:*)",
      "Bash(do:*)",
      "Bash(done)",
      "Bash(git notes:*)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "Bash(.venv/Scripts/python.exe:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "outputStyle": "default",
  "defaultMode": "bypassPermissions"
}
