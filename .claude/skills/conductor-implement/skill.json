{
  "name": "conductor-implement",
  "description": "Execute a Conductor track plan with automatic TDD workflow (Red-Green-Refactor cycle)",
  "author": "Claude Sonnet 4.5",
  "parameters": {
    "track": {
      "type": "string",
      "description": "Track identifier (e.g., feature_implement_operator_workflow_20260111)",
      "required": true
    },
    "start_phase": {
      "type": "number",
      "description": "Starting phase number (for resume)",
      "default": 1
    },
    "auto_mode": {
      "type": "boolean",
      "description": "Run without user interaction (demo mode)",
      "default": false
    }
  }
}
