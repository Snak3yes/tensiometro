{
  "name": "conductor-revert",
  "description": "Revert a Conductor track, phase, or task using git reset",
  "author": "Claude Sonnet 4.5",
  "parameters": {
    "track": {
      "type": "string",
      "description": "Track identifier",
      "required": true
    },
    "phase": {
      "type": "number",
      "description": "Phase number to revert to (optional)"
    },
    "confirm": {
      "type": "boolean",
      "description": "Skip confirmation prompt",
      "default": false
    }
  }
}
